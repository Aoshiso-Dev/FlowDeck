        <Expander Header="手動時の温度保護"><StackPanel><CheckBox Content="CPU必須" IsChecked="{Binding ProtectManualCpu}"/><TextBlock Text="過熱温度 / 復帰温度（°C）" Style="{StaticResource Label}"/><UniformGrid Columns="2"><TextBox Text="{Binding ManualCpuOverheat,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/><TextBox Text="{Binding ManualCpuResume,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid><CheckBox Content="GPU必須" IsChecked="{Binding ProtectManualGpu}"/><TextBlock Text="過熱温度 / 復帰温度（°C）" Style="{StaticResource Label}"/><UniformGrid Columns="2"><TextBox Text="{Binding ManualGpuOverheat,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/><TextBox Text="{Binding ManualGpuResume,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid></StackPanel></Expander>
       </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="起動・表示・実行環境" Style="{StaticResource SectionTitle}"/><CheckBox Content="ログオン時に起動" IsChecked="{Binding LoginStartup}"/><CheckBox Content="起動時に制御を再開（確認済みのみ）" IsChecked="{Binding ResumeStartup}"/><TextBlock Text="配色（system：OS連動）" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/><StackPanel Visibility="{Binding UsesDirectCooling,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Python 3.13 実行ファイル（絶対パス）" Style="{StaticResource Label}"/><local:DraftTextBox x:Name="PythonPathBox" Style="{StaticResource {x:Type TextBox}}" Draft="{Binding PythonPath}" TextWrapping="Wrap"/></StackPanel><TextBlock Text="{Binding VersionInfo}" Style="{StaticResource Muted}" Margin="0,15,0,0"/></StackPanel></Border>
       </StackPanel>
      </Grid>
      <WrapPanel Margin="0,0,0,20"><Button Content="保存" Command="{Binding SaveSettings}" Style="{StaticResource Primary}"/><Button Content="元に戻す" Command="{Binding RefreshSettings}"/></WrapPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=5}">
      <Button Content="マザーファン" Command="{Binding Navigate}" CommandParameter="8" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <Button Content="表示項目" Command="{Binding Navigate}" CommandParameter="6" HorizontalAlignment="Left" Margin="0,0,0,16"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="{Binding BoardName}" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="{Binding BoardStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Text="端子名・電圧換算・実配線は未確認 / 0 rpm：停止・未接続の判別不可" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
       <DataGrid ItemsSource="{Binding BoardSensors}" Height="310" Margin="0,12,0,8" CanUserSortColumns="False">
        <DataGrid.Columns>
         <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" Width="150"/>
         <DataGridTextColumn Header="種別" Binding="{Binding Kind}" IsReadOnly="True" Width="65"/>
         <DataGridTextColumn Header="値" Binding="{Binding Value}" IsReadOnly="True" Width="100"/>
         <DataGridTextColumn Header="確認状態" Binding="{Binding Status}" IsReadOnly="True" Width="150"/>
         <DataGridTextColumn Header="取得元" Binding="{Binding Source}" IsReadOnly="True" Width="280"/>
         <DataGridTextColumn Header="識別ID" Binding="{Binding Id}" IsReadOnly="True" Width="250"/>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="RGB・ARGB" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="通常：ASRock USB / OpenRGB：ASRockのみ検出・NZXT検出無効・SDK 127.0.0.1" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
       <WrapPanel Margin="0,10"><CheckBox Content="OpenRGB" IsChecked="{Binding OpenRgbEnabled}" VerticalAlignment="Center"/><TextBlock Text="ポート" Margin="12,0,6,0" VerticalAlignment="Center"/><TextBox Text="{Binding OpenRgbPort,UpdateSourceTrigger=PropertyChanged}" Width="75" MaxLength="5"/></WrapPanel>
       <WrapPanel><Button Content="保存" Command="{Binding SaveMotherboard}" Style="{StaticResource Primary}"/><Button Content="再読込" Command="{Binding ReloadMotherboard}"/><Button Content="再取得" Command="{Binding RefreshRgb}"/></WrapPanel>
       <TextBlock Text="{Binding RgbStatus}" TextWrapping="Wrap" Margin="0,8"/>
       <DataGrid ItemsSource="{Binding RgbZones}" Height="190"><DataGrid.Columns>
        <DataGridTextColumn Header="ゾーン" Binding="{Binding Details.Zone}" IsReadOnly="True" Width="150"/>
        <DataGridTextColumn Header="機器名" Binding="{Binding Accessory,UpdateSourceTrigger=PropertyChanged}" Width="180"/>
        <DataGridTextColumn Header="確認済みLED数" Binding="{Binding ConfirmedLeds,UpdateSourceTrigger=PropertyChanged}" Width="115"/>
        <DataGridTextColumn Header="取得LED数" Binding="{Binding Details.Leds}" IsReadOnly="True" Width="110"/>
        <DataGridTextColumn Header="設定モード" Binding="{Binding Details.Mode}" IsReadOnly="True" Width="110"/>
        <DataGridTextColumn Header="コントローラー" Binding="{Binding Details.Controller}" IsReadOnly="True" Width="180"/>
        <DataGridTextColumn Header="対応モード" Binding="{Binding Details.Modes}" IsReadOnly="True" Width="230"/>
        <DataGridTextColumn Header="取得元" Binding="{Binding Details.Source}" IsReadOnly="True" Width="240"/>
       </DataGrid.Columns></DataGrid>
       <TextBlock Text="取得LED数・モード：機器の設定値 / 登録LED数：実配線を確認済みの値（未確認は空欄） / 登録は表示用のみ" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <local:NotificationsView x:Name="NotificationsPanel" Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=9}"/>
     <local:SettingsTransferView x:Name="SettingsTransferPanel" Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=10}"/>
     <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=4}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="問題・接続情報" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Banner}" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="{Binding VersionInfo}" Style="{StaticResource Muted}" Margin="0,12"/><Button Content="ログ保存" Command="{Binding ExportLog}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="操作履歴" Style="{StaticResource SectionTitle}"/><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding DiagnosticFilters}" SelectedItem="{Binding DiagnosticFilter}" Width="160" HorizontalAlignment="Right"/></DockPanel><DataGrid ItemsSource="{Binding FilteredHistory}" SelectedItem="{Binding SelectedOperation}" IsReadOnly="True" Height="250"><DataGrid.Columns><DataGridTextColumn Header="時刻" Binding="{Binding Time,StringFormat=HH:mm:ss}" Width="75"/><DataGridTextColumn Header="操作元" Binding="{Binding Source}" Width="75"/><DataGridTextColumn Header="結果" Binding="{Binding Outcome}" Width="110"/><DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid><Expander Header="要求ID・チャンネル別結果" IsExpanded="True"><TextBox Text="{Binding OperationDetail,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="280" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></Border>
      <Border Style="{StaticResource Card}" Visibility="{Binding Demo,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="異常・切断テスト" Style="{StaticResource SectionTitle}"/><WrapPanel><Button Content="次回FAN3不一致" Command="{Binding DemoFault}" CommandParameter="partial"/><Button Content="Hub切断 / 復帰" Command="{Binding DemoFault}" CommandParameter="hub"/><Button Content="温度欠落 / 復帰" Command="{Binding DemoFault}" CommandParameter="sensor"/></WrapPanel></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}" Padding="16,7"><TextBlock Text="{Binding Footer}" Style="{StaticResource Muted}"/></Border>
 </Grid>
