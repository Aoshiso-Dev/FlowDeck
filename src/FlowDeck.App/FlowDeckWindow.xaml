<Window x:Class="FlowDeck.App.FlowDeckWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App"
 Title="FlowDeck" Icon="Assets/FlowDeck.ico" Width="1100" Height="800" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
 <Grid Background="{DynamicResource BackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,26,12,24"><Image Source="Assets/FlowDeck-preview.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="FlowDeck" FontWeight="SemiBold" FontSize="17"/></StackPanel></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="16,18"><Button Content="{Binding SwitchLabel}" Command="{Binding SwitchMode}" FontSize="11" Padding="6,7"/><TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Button Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="0"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" Width="27" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="モニター"/></StackPanel></Button><Button Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="7"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Width="27" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="冷却"/></StackPanel></Button><Button Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="2"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE781;" Width="27" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="照明"/></StackPanel></Button><Button Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="3"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE115;" Width="27" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="設定"/></StackPanel></Button></StackPanel></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,20,20,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="21" FontWeight="Light"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding HubLabel}" Style="{StaticResource Muted}" Margin="8"/></StackPanel></Grid>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Visibility="{Binding HasBanner,Converter={StaticResource BoolVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="再開" Command="{Binding Resume}" Style="{StaticResource Primary}"/><TextBlock Text="{Binding Banner}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/></DockPanel></Border>
   <TextBlock Grid.Row="2" Text="{Binding Notice}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12" AutomationProperties.Name="操作メッセージ"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <ScrollViewer x:Name="PageScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
    <Grid>
     <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=0}">
      <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="表示項目" Command="{Binding Navigate}" CommandParameter="6" FontSize="11" Padding="10,5" MinHeight="28" Margin="0"/><TextBlock Text="温度" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="表示項目なし" Style="{StaticResource Muted}" Margin="0,0,0,16" Visibility="{Binding DashboardEmptyTemperatures,Converter={StaticResource BoolVisibility}}"/>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemperatureCards}"/>
      <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
       <DockPanel Margin="18,14"><TextBlock Text="ファン・ポンプ" FontWeight="SemiBold"/><TextBlock Text="回転数" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
       <TextBlock Text="表示項目なし" Style="{StaticResource Muted}" Margin="18,0,18,14" Visibility="{Binding DashboardEmptyFans,Converter={StaticResource BoolVisibility}}"/>
       <ItemsControl x:Name="DashboardFanGrid" ItemsSource="{Binding DashboardFans}" AutomationProperties.Name="統合ファン・ポンプ一覧"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="70"/><ColumnDefinition Width="145"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
         <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FanGlyph}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Role}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
         <ContentControl Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource RpmReadout}" ToolTip="{Binding State}"/>
         <Button Grid.Column="4" Content="›" FontSize="20" BorderBrush="Transparent" Background="Transparent" Padding="8,0" Margin="12,0,0,0" Command="{Binding DataContext.DashboardDetails,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name,StringFormat={}{0} の設定を開く}"/>
        </Grid></Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Expander x:Name="DashboardHistoryExpander" Header="履歴" Margin="0,0,0,16">
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding DashboardTrendOptions}" SelectedItem="{Binding DashboardTrend}" DisplayMemberPath="Name" Width="260"/><TextBlock Text="直近10分" Style="{StaticResource SectionTitle}"/></DockPanel>
       <local:HistoryChart Samples="{Binding DashboardTrendSamples}" Now="{Binding DashboardTrendNow}" Unit="{Binding DashboardTrendUnit}" Height="170" Margin="0,10,0,0"/>

      </StackPanel></Border>
      </Expander>
     </StackPanel>
     <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=6}">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="表示項目" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="ポンプの割り当てには実配線の確認が必要" Style="{StaticResource Muted}"/>
       <DataGrid x:Name="DashboardSettingsGrid" ItemsSource="{Binding DashboardChoices}" SelectedItem="{Binding DashboardSelected}" Height="340" RowHeight="45" Margin="0,14" CanUserSortColumns="False" AutomationProperties.Name="ダッシュボード表示項目">
        <DataGrid.Columns>
         <DataGridCheckBoxColumn Header="表示" Binding="{Binding Visible,UpdateSourceTrigger=PropertyChanged}" Width="45"/>
         <DataGridTextColumn Header="名前" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="180"/>
         <DataGridTextColumn Header="種別" Binding="{Binding Kind}" IsReadOnly="True" Width="65"/>
         <DataGridTemplateColumn Header="役割" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsFan,Converter={StaticResource BoolVisibility}}" Margin="2,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="取得元" Binding="{Binding Source}" IsReadOnly="True" Width="110"/>
         <DataGridTextColumn Header="現在値・状態" Binding="{Binding Current}" IsReadOnly="True" Width="180"/>
         <DataGridTextColumn Header="識別ID" Binding="{Binding SensorId}" IsReadOnly="True" Width="260"/>
        </DataGrid.Columns>
       </DataGrid>
       <WrapPanel><Button Content="↑" Command="{Binding MoveDashboard}" CommandParameter="up"/><Button Content="↓" Command="{Binding MoveDashboard}" CommandParameter="down"/><Button Content="保存" Command="{Binding SaveDashboard}" Style="{StaticResource Primary}"/><Button Content="変更を破棄" Command="{Binding ReloadDashboard}"/><Button Content="初期値" Command="{Binding ResetDashboard}"/></WrapPanel>

      </StackPanel></Border>
      <WrapPanel Margin="0,0,0,18"><Button Content="モニター" Command="{Binding Navigate}" CommandParameter="0"/><Button Content="マザーボード" Command="{Binding Navigate}" CommandParameter="5"/></WrapPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=7|8}">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemperatureCards}"/>
      <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
       <DockPanel Margin="18,14"><TextBlock Text="NZXT Control Hub" FontWeight="SemiBold"/><TextBlock Text="共通制御" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
       <ItemsControl ItemsSource="{Binding NzxtFanReadings}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
         <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FanGlyph}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Role}" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
         <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource RpmReadout}"/>
         <TextBlock Grid.Column="3" Text="{Binding Control}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid></Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander x:Name="HubControlExpander" Header="共通出力" IsExpanded="{Binding HubControlsOpen,Mode=TwoWay}" Margin="0"><Border Background="{DynamicResource InsetBrush}" Padding="24,16"><StackPanel>
       <Border Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="4"><UniformGrid Columns="2">
        <RadioButton x:Name="NzxtManualSegment" Content="手動" GroupName="NzxtMode" Style="{StaticResource Segmented}" IsChecked="{Binding DraftMode,Converter={StaticResource Choice},ConverterParameter=Manual,Mode=TwoWay}"/>
        <RadioButton x:Name="NzxtAutoSegment" Content="自動" GroupName="NzxtMode" Style="{StaticResource Segmented}" IsChecked="{Binding DraftMode,Converter={StaticResource Choice},ConverterParameter=Auto,Mode=TwoWay}"/>
       </UniformGrid></Border>
       <StackPanel Visibility="{Binding DraftMode,Converter={StaticResource PageVisibility},ConverterParameter=Auto}" Margin="0,18,0,12"><TextBlock Text="プリセット" Style="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="自動プリセット"/><Button Content="温度カーブ" Command="{Binding Navigate}" CommandParameter="1" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
       <StackPanel Visibility="{Binding DraftMode,Converter={StaticResource PageVisibility},ConverterParameter=Manual}" Margin="0,18,0,8">
        <DockPanel><TextBlock Text="出力" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="{Binding ManualText,StringFormat={}{0}%}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="NzxtFanDutySlider" Value="{Binding ManualDuty,UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding MinimumDuty}" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0" AutomationProperties.Name="共通出力スライダー"/>
        <DockPanel><TextBlock Text="{Binding MinimumDuty,StringFormat={}{0}%}" Style="{StaticResource Muted}"/><TextBlock Text="100%" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
       </StackPanel>
       <WrapPanel Margin="0,12,0,12"><Button Content="適用" Command="{Binding ApplyFan}" Style="{StaticResource Primary}" MinWidth="110"/><Button Content="元に戻す" Command="{Binding RevertFan}"/><TextBlock Text="{Binding FanDraftLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
       <Expander Header="接続・制御"><StackPanel><TextBlock Text="{Binding HubControlReadiness}" Style="{StaticResource Muted}"/><Button Content="設定" Command="{Binding Navigate}" CommandParameter="3" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
       </StackPanel></Border></Expander>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
       <DockPanel Margin="18,14"><TextBlock Text="{Binding BoardName}" FontWeight="SemiBold"/><TextBlock Text="{Binding BoardFanCount}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
       <ListBox x:Name="BoardFanList" ItemsSource="{Binding BoardFanRows}" SelectedValue="{Binding SelectedBoardFan}" SelectedValuePath="Port" IsEnabled="{Binding BoardFanCanSelect}" BorderThickness="0" Background="Transparent" Padding="0" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewKeyDown="BoardFanKeyDown" AutomationProperties.Name="検出されたマザーファン">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><StackPanel>
         <Border x:Name="FanRow" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><ContentPresenter/></Border>
         <ContentControl x:Name="InlineEditorHost"/>
        </StackPanel><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="FanRow" Property="Background" Value="{DynamicResource InsetBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Button Click="BoardFanRowClick" Padding="18,10" Margin="0" BorderBrush="Transparent" Background="Transparent" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}" ToolTip="出力設定">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FanGlyph}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Port.SensorId}"/><TextBlock Text="{Binding Role}" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
          <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource RpmReadout}"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Mode}" Style="{StaticResource Muted}"/><TextBlock Text="⌄" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0"/></StackPanel>
         </Grid>
        </Button></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel></Border>
      <TextBlock Text="検出チャンネル数 ≠ 物理端子数" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
     </StackPanel>
     <StackPanel x:Name="BoardEditorParking" Visibility="Collapsed">
      <Border x:Name="CpuFanCard" Style="{StaticResource Card}" Padding="24,18" Margin="0" BorderThickness="0" Background="{DynamicResource InsetBrush}" VerticalAlignment="Top"><StackPanel>
       <TextBlock Text="{Binding BoardFanTitle,StringFormat={}{0} の出力設定}" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock Text="{Binding BoardFanOutputNote}" Style="{StaticResource OptionalNote}"/>
       <TextBlock Text="{Binding CpuFanStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,16"/>
       <Border Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="4" IsEnabled="{Binding BoardFanCanSelect}"><UniformGrid Columns="2">
        <RadioButton x:Name="BoardManualSegment" Content="手動" GroupName="BoardMode" Style="{StaticResource Segmented}" IsChecked="{Binding BoardFanEditMode,Converter={StaticResource Choice},ConverterParameter=手動,Mode=TwoWay}"/>
        <RadioButton x:Name="BoardAutoSegment" Content="自動" GroupName="BoardMode" Style="{StaticResource Segmented}" IsChecked="{Binding BoardFanEditMode,Converter={StaticResource Choice},ConverterParameter=自動,Mode=TwoWay}"/>
       </UniformGrid></Border>
       <StackPanel Margin="0,14,0,10" Visibility="{Binding BoardFanEditMode,Converter={StaticResource PageVisibility},ConverterParameter=手動}">
        <DockPanel><TextBlock Text="出力" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="{Binding CpuFanDuty,StringFormat={}{0}%}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="BoardFanDutySlider" Value="{Binding CpuFanDuty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding BoardFanMinimumDuty}" Maximum="100" IsEnabled="{Binding BoardFanCanSelect}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5" Margin="0,6,0,0" AutomationProperties.Name="マザーファンの出力スライダー"/>
        <DockPanel><TextBlock Text="{Binding BoardFanMinimumDuty,StringFormat={}{0}%}" Style="{StaticResource Muted}"/><TextBlock Text="100%" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></DockPanel>
       </StackPanel>
       <TextBlock Text="保存済みカーブ" Style="{StaticResource Muted}" Margin="0,20" Visibility="{Binding BoardFanEditMode,Converter={StaticResource PageVisibility},ConverterParameter=自動}"/>
       <WrapPanel><Button Content="適用" Command="{Binding BoardFanApply}" Style="{StaticResource Primary}" MinWidth="100"/><Button Content="マザー管理へ" Command="{Binding CpuFanRestore}"/></WrapPanel>
       <TextBlock Text="{Binding BoardFanSetupSummary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,8"/>
       <Expander x:Name="BoardFanSetupExpander" Header="初期設定" Margin="0,8"><StackPanel Margin="0,10,0,0">
       <TextBlock Text="端子テストで実配線を確認" Style="{StaticResource Muted}"/>
       <Button Content="端子テスト（100%・5秒後に復元）" Command="{Binding CpuFanTest}" HorizontalAlignment="Left" Margin="0,10"/>
       <CheckBox Content="{Binding BoardFanWiringLabel}" IsChecked="{Binding CpuFanWiringConfirmed}"/>
       <WrapPanel Margin="0,8"><TextBlock Text="確認済み最低出力 (%)" VerticalAlignment="Center"/><TextBox Text="{Binding CpuFanMinimum,UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="8,0,15,0"/></WrapPanel><WrapPanel><Button Content="端子・カーブを保存" Command="{Binding CpuFanSave}"/><Button Content="再読込" Command="{Binding CpuFanReload}"/></WrapPanel>
       <TextBlock Text="停止・通常終了：開始前へ復元 / スリープ復帰：手動で再適用" Style="{StaticResource Muted}" Margin="0,10"/>
       </StackPanel></Expander>
       <Expander x:Name="CpuFanCurveExpander" Header="温度カーブ" Margin="0,8"><StackPanel>
        <TextBlock Text="2つのカーブの高い出力を採用。過熱・温度欠落・出力不一致：100%・自動復帰なし" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
        <TextBlock Text="温度センサー1" Margin="0,10,0,4"/>
        <ComboBox ItemsSource="{Binding BoardFanTemperatures}" SelectedValue="{Binding CpuFanSensorId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
        <local:CurveChart x:Name="BoardCpuCurve" Points="{Binding CpuFanPoints}" SelectedPoint="{Binding CpuFanSelectedPoint,Mode=TwoWay}" MinimumDuty="{Binding BoardCurveMinimum}" AllowStop="False" CurrentTemperature="{Binding BoardCurveTemperature}" CurrentDuty="{Binding BoardCurveDuty}" Height="250" Margin="0,12"/>
        <Expander Header="数値一覧" Margin="0,4,0,8"><DataGrid ItemsSource="{Binding CpuFanPoints}" SelectedItem="{Binding CpuFanSelectedPoint}" Height="160" Margin="0,10" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="温度 (°C)" Binding="{Binding Temperature,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="出力 (%)" Binding="{Binding Duty,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid></Expander>
        <WrapPanel><Button Content="追加" Command="{Binding AddPointCommand,ElementName=BoardCpuCurve}"/><Button Content="削除" Command="{Binding DeletePointCommand,ElementName=BoardCpuCurve}"/></WrapPanel>
        <WrapPanel Margin="0,8"><TextBlock Text="過熱 (°C)" VerticalAlignment="Center"/><TextBox Text="{Binding CpuFanOverheat,UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0,15,0"/><TextBlock Text="開始・再開上限 (°C)" VerticalAlignment="Center"/><TextBox Text="{Binding CpuFanResume,UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0"/></WrapPanel>
        <CheckBox Content="温度センサー2" IsChecked="{Binding CpuFanGpuEnabled}" Margin="0,16,0,8"/>
        <StackPanel IsEnabled="{Binding CpuFanGpuEnabled}">
         <ComboBox ItemsSource="{Binding BoardFanTemperatures}" SelectedValue="{Binding CpuFanGpuSensorId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
         <local:CurveChart x:Name="BoardGpuCurve" Points="{Binding CpuFanGpuPoints}" SelectedPoint="{Binding CpuFanGpuSelectedPoint,Mode=TwoWay}" MinimumDuty="{Binding BoardCurveMinimum}" AllowStop="False" CurrentTemperature="{Binding BoardCurveGpuTemperature}" CurrentDuty="{Binding BoardCurveDuty}" Height="250" Margin="0,12"/>
         <Expander Header="数値一覧" Margin="0,4,0,8"><DataGrid ItemsSource="{Binding CpuFanGpuPoints}" SelectedItem="{Binding CpuFanGpuSelectedPoint}" Height="150" Margin="0,10" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="温度 (°C)" Binding="{Binding Temperature,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="出力 (%)" Binding="{Binding Duty,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid></Expander>
         <WrapPanel><Button Content="追加" Command="{Binding AddPointCommand,ElementName=BoardGpuCurve}"/><Button Content="削除" Command="{Binding DeletePointCommand,ElementName=BoardGpuCurve}"/></WrapPanel>
         <WrapPanel Margin="0,8"><TextBlock Text="過熱 (°C)" VerticalAlignment="Center"/><TextBox Text="{Binding CpuFanGpuOverheat,UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0,15,0"/><TextBlock Text="開始・再開上限 (°C)" VerticalAlignment="Center"/><TextBox Text="{Binding CpuFanGpuResume,UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0"/></WrapPanel>
        </StackPanel>
        <WrapPanel Margin="0,8"><TextBlock Text="下降待機 (秒)" VerticalAlignment="Center"/><TextBox Text="{Binding CpuFanDelay,UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0,15,0"/><TextBlock Text="下降速度 (%/秒)" VerticalAlignment="Center"/><TextBox Text="{Binding CpuFanRate,UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0"/></WrapPanel>
        <WrapPanel><Button Content="端子・カーブを保存" Command="{Binding CpuFanSave}"/><Button Content="再読込" Command="{Binding CpuFanReload}"/></WrapPanel>
       </StackPanel></Expander>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=1}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="温度カーブ" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurveProfile}" DisplayMemberPath="Name" MaxWidth="350" HorizontalAlignment="Left" MinWidth="230"/><TextBlock Text="{Binding CurveStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="17"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="CPU" IsChecked="{Binding UseCpu}"/><TextBlock Text="{Binding CpuName}" Style="{StaticResource Muted}"/><local:CurveChart x:Name="HubCpuCurve" Points="{Binding CpuPoints}" SelectedPoint="{Binding SelectedCpuPoint,Mode=TwoWay}" MinimumDuty="{Binding HubCurveMinimum}" AllowStop="{Binding HubCurveAllowStop}" CurrentTemperature="{Binding HubCurveCpuTemperature}" CurrentDuty="{Binding HubCurveDuty}" Height="250" Margin="0,12"/><Expander Header="数値一覧" Margin="0,4,0,8"><DataGrid CanUserSortColumns="False" ItemsSource="{Binding CpuPoints}" SelectedItem="{Binding SelectedCpuPoint}" Height="170"><DataGrid.Columns><DataGridTextColumn Header="温度 °C" Binding="{Binding Temperature,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="要求出力 %" Binding="{Binding Duty,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid></Expander><WrapPanel Margin="0,10"><Button Content="追加" Command="{Binding AddPointCommand,ElementName=HubCpuCurve}"/><Button Content="削除" Command="{Binding DeletePointCommand,ElementName=HubCpuCurve}"/></WrapPanel><TextBlock Text="過熱温度 / 復帰温度（°C）" Style="{StaticResource Label}"/><UniformGrid Columns="2"><TextBox Text="{Binding CpuOverheat,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.Name="CPU過熱温度"/><TextBox Text="{Binding CpuResume,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CPU復帰温度"/></UniformGrid></StackPanel></Border>
