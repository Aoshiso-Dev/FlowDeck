<Window x:Class="FlowDeck.App.LocalMonitoringWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FlowDeck" Width="1020" Height="720" MinWidth="860" MinHeight="540" WindowStartupLocation="CenterScreen"
 Icon="Assets/FlowDeck.ico" Style="{StaticResource {x:Type Window}}">
 <Border Background="{DynamicResource BackgroundBrush}" Padding="28"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="ThemeChoice" Width="124" SelectedValuePath="Tag" Margin="0,0,12,0" AutomationProperties.Name="配色"><ComboBoxItem Content="システム" Tag="system"/><ComboBoxItem Content="ライト" Tag="light"/><ComboBoxItem Content="ダーク" Tag="dark"/></ComboBox><Button x:Name="ServiceButton" Content="サービス接続" MinWidth="108" Click="ConnectService"/></StackPanel>
   <StackPanel><TextBlock Text="FlowDeck" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="サービス未接続 · NVIDIA GPU監視" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="温度" Style="{StaticResource SectionTitle}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemperatureCards}"/>
   <TextBlock Text="ファン回転数" Style="{StaticResource SectionTitle}"/>
   <ItemsControl ItemsSource="{Binding DashboardFans}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource RpmReadout}"/>
   </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="CloseButton" Content="閉じる" DockPanel.Dock="Right" Click="Exit" Margin="12,0,0,0"/><TextBlock x:Name="NoticeText" Style="{StaticResource OptionalNote}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/></DockPanel>
 </Grid></Border>
</Window>
