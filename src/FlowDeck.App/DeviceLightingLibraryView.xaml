<UserControl x:Class="FlowDeck.App.DeviceLightingLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App">
 <StackPanel>
  <WrapPanel Margin="0,12,0,0"><Button Content="新規グループ" Command="{Binding NewLightLibrary}"/><Button Content="グループ編集" Command="{Binding EditLightGroup}"/><Button Content="新規シーン" Command="{Binding NewLightLibrary}" CommandParameter="scene"/><Button Content="シーン編集" Command="{Binding EditLightScene}"/></WrapPanel>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,18" Margin="0,14,0,0" Visibility="{Binding HasLightLibraryEditor,Converter={StaticResource BoolVisibility}}">
   <StackPanel IsEnabled="{Binding LightingIdle}">
    <StackPanel DataContext="{Binding LightLibraryEditor}">
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <local:DraftTextBox Style="{StaticResource {x:Type TextBox}}" Draft="{Binding Name}" MaxLength="80" AutomationProperties.Name="保存する照明の名前"/>
    </StackPanel>
    <DockPanel Margin="0,12,0,8" Visibility="{Binding LightLibraryEditor.IsScene,Converter={StaticResource BoolVisibility}}">
     <WrapPanel DockPanel.Dock="Right"><Button Content="パート追加" Command="{Binding AddLightScenePart}"/><Button Content="パート削除" Command="{Binding RemoveLightScenePart}"/></WrapPanel>
     <ComboBox ItemsSource="{Binding LightLibraryEditor.Parts}" SelectedValue="{Binding LightLibraryEditor.SelectedPart}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="保存するシーンのパート"/>
    </DockPanel>
    <Grid Margin="0,8,0,0" DataContext="{Binding LightLibraryEditor}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ScrollViewer MaxHeight="320" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Members}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Available}" Margin="0,6" AutomationProperties.Name="保存する照明の対象"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel Grid.Column="2" Visibility="{Binding HasPart,Converter={StaticResource BoolVisibility}}">
      <ComboBox ItemsSource="{Binding Effects}" SelectedValue="{Binding Effect}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,0,12" AutomationProperties.Name="保存するシーンの効果"/>
      <TextBlock Text="{Binding CapabilityIssue}" Style="{StaticResource OptionalNote}" Margin="0,0,0,8"/>
      <CheckBox Content="LED別色" IsChecked="{Binding PerLed}" Visibility="{Binding AllowsPerLed,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10" AutomationProperties.Name="保存するシーンのLED別色"/>
      <DockPanel Margin="0,0,0,12" Visibility="{Binding HasPalette,Converter={StaticResource BoolVisibility}}">
       <WrapPanel DockPanel.Dock="Right"><Button Content="＋" Command="{Binding AddColor}" AutomationProperties.Name="シーンに色を追加"/><Button Content="−" Command="{Binding RemoveColor}" AutomationProperties.Name="シーンの色を削除"/></WrapPanel>
       <ComboBox ItemsSource="{Binding Palette}" SelectedValuePath="Index" SelectedValue="{Binding SelectedColor}" AutomationProperties.Name="編集するシーンの色"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="22" Height="18" Background="{Binding Brush}" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      </DockPanel>
      <local:ColorPicker SelectedColor="{Binding Color}" Palette="{Binding SavedColors}" IsEnabled="{Binding CanPickColor}"/>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="明るさ" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Value="{Binding Brightness,UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding CanEditBrightness}" AutomationProperties.Name="保存するシーンの明るさ"/><TextBlock Grid.Column="2" Text="{Binding Brightness,StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Grid Margin="0,8,0,0" Visibility="{Binding HasSpeed,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="速さ" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Value="{Binding Speed,UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding SpeedMinimum}" Maximum="{Binding SpeedMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="保存するシーンの速さ"/><TextBlock Grid.Column="2" Text="{Binding Speed}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <CheckBox Content="逆方向" IsChecked="{Binding Reverse}" Visibility="{Binding HasDirection,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" AutomationProperties.Name="保存するシーンの逆方向"/>
     </StackPanel>
    </Grid>
    <TextBlock Text="{Binding LightLibraryEditor.Status}" Style="{StaticResource OptionalNote}" Margin="0,12,0,0"/>
    <WrapPanel Margin="0,12,0,0"><Button Content="保存" Style="{StaticResource Primary}" Command="{Binding SaveLightLibraryEditor}"/><Button Content="再取得" Command="{Binding ReloadLightLibraryEditor}"/><Button Content="削除" Command="{Binding DeleteLightLibraryEditor}"/><Button Content="閉じる" Command="{Binding CloseLightLibraryEditor}"/></WrapPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
