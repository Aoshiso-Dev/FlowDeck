<UserControl x:Class="FlowDeck.App.DeviceCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate>
  <Border Style="{StaticResource Card}"><StackPanel>
   <Expander Header="{Binding Name}" IsExpanded="{Binding Expanded,Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"><StackPanel Margin="0,12,0,0">
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
     <TextBlock Text="機能・現在の状態" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="対応状況" Style="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="確認の根拠" Style="{StaticResource Muted}"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding VisibleEndpoints}"><ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,8,0,12">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="対応情報なし" Style="{StaticResource Muted}" Margin="0,6" Visibility="{Binding Empty,Converter={StaticResource BoolVisibility}}"/>
      <ItemsControl ItemsSource="{Binding Capabilities}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10" AutomationProperties.Name="{Binding Value.AutomationLabel}">
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Value.Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Value.Availability}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
         <TextBlock Grid.Column="1" Text="{Binding Value.Support}" Margin="0,0,12,0" TextWrapping="Wrap"/>
         <TextBlock Grid.Column="2" Text="{Binding Value.Evidence}" TextWrapping="Wrap"/>
        </Grid>
         <TextBlock Text="{Binding Value.Reason}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Value.HasReason,Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="識別情報" Margin="0,10,0,0"><TextBlock Text="{Binding IdentityDetails}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></Expander>
   </StackPanel></Expander>
   <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.Name="機器の利用状態"/>
  </StackPanel></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</UserControl>
