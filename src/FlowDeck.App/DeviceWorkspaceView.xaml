      <TextBlock Text="{Binding SetupUsage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <DockPanel Margin="0,10,0,12"><Button DockPanel.Dock="Right" Content="再取得" Command="{Binding ReloadSetup}"/><ComboBox ItemsSource="{Binding SetupChoices}" SelectedItem="{Binding SelectedSetup}" DisplayMemberPath="Name" IsEnabled="{Binding SetupIdle}" AutomationProperties.Name="設定する端子"/></DockPanel>
      <StackPanel DataContext="{Binding SetupEditor}" IsEnabled="{Binding DataContext.SetupIdle,RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding DataContext.HasSetupEditor,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BoolVisibility}}">
