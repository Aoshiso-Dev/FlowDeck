<UserControl x:Class="FlowDeck.App.DeviceWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
 <Grid>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,26,12,24"><Image Source="Assets/FlowDeck-preview.png" Width="34" Height="34"/><TextBlock Text="FlowDeck" FontWeight="SemiBold" FontSize="17" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="16">
    <TextBlock Text="テーマ" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Theme}" AutomationProperties.Name="テーマ"/>
    <TextBlock Text="アクセントカラー" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
    <ComboBox ItemsSource="{Binding AccentChoices}" SelectedValuePath="Hex" SelectedValue="{Binding AccentColor}" AutomationProperties.AutomationId="AccentColorChoice" AutomationProperties.Name="アクセントカラー">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" CornerRadius="6" Background="{Binding Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <Button Content="カスタム…" Click="ChooseAccentColor" Margin="0,5,0,0" Padding="8,5" ToolTip="アクセントカラー" AutomationProperties.AutomationId="CustomAccentColorButton" AutomationProperties.Name="カスタムのアクセントカラーを選択"/>
    <TextBlock Text="{Binding EnvironmentLabel}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
   </StackPanel>
   <StackPanel><Button Content="モニター" Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="0"/><Button Content="冷却" Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="1"/><Button Content="照明" Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="2"/><Button Content="設定" Style="{StaticResource Nav}" Command="{Binding Navigate}" CommandParameter="3"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="24,24,18,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12" MinHeight="28">
    <Button DockPanel.Dock="Right" Content="再接続" Command="{Binding Reconnect}" Visibility="{Binding ShowReconnect,Converter={StaticResource BoolVisibility}}" Margin="12,0,0,0" AutomationProperties.AutomationId="ReconnectServiceButton" AutomationProperties.Name="サービスに再接続"/>
    <TextBlock Text="{Binding DeviceCountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="ConnectedDeviceCount"/>
    <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="ServiceConnectionLabel"/>
   </DockPanel>
   <ScrollViewer Grid.Row="1" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" AutomationProperties.AutomationId="WorkspaceWarningScroll" AutomationProperties.Name="重要な状態とエラー">
    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
     <DataTrigger Binding="{Binding WarningMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></ScrollViewer.Style>
    <TextBlock x:Name="WorkspaceWarningMessage" Text="{Binding WarningMessage}" Style="{StaticResource OptionalNote}" Foreground="{DynamicResource WarningBrush}"
     AutomationProperties.AutomationId="WorkspaceWarningMessage" AutomationProperties.Name="{Binding WarningMessage}" AutomationProperties.LiveSetting="Assertive"/>
   </ScrollViewer>
   <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
    <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=0}">
     <TextBlock Text="モニター" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="MonitorPageTitle"/>
     <Button Content="センサーを追加" Command="{Binding Navigate}" CommandParameter="3" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="{Binding HasMonitoringCandidates,Converter={StaticResource BoolVisibility}}"/>
     <TextBlock Text="温度" Style="{StaticResource SubsectionTitle}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemperatureCards}"/>
     <TextBlock Text="ファン・ポンプ" Style="{StaticResource SubsectionTitle}" Margin="0,8,0,12"/>
     <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
      <ItemsControl ItemsSource="{Binding DashboardFans}" Grid.IsSharedSizeScope="True"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto" SharedSizeGroup="MonitorFanNames"/><ColumnDefinition Width="112"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FanGlyph}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="180" Margin="0,0,24,0"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" AutomationProperties.AutomationId="MonitorFanName"/><TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Connection}"/></StackPanel>
        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource RpmReadout}" ToolTip="{Binding State}" AutomationProperties.AutomationId="MonitorFanRpm"/>
        <TextBlock Grid.Column="3" Text="{Binding Role}" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0"/>
       </Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
     <Expander Header="推移"><StackPanel><ComboBox ItemsSource="{Binding DashboardTrendOptions}" SelectedItem="{Binding DashboardTrend}" DisplayMemberPath="Name"/><local:HistoryChart Samples="{Binding DashboardTrendSamples}" Now="{Binding DashboardTrendNow}" Unit="{Binding DashboardTrendUnit}" Height="170"/></StackPanel></Expander>
    </StackPanel>
    <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=1}" AutomationProperties.AutomationId="CoolingPage">
     <TextBlock Text="冷却" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="CoolingPageTitle"/>
     <ItemsControl ItemsSource="{Binding VisibleCooling}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" CornerRadius="4" Margin="0,0,0,22" AutomationProperties.AutomationId="CoolingDeviceCard"><StackPanel>
       <Grid AutomationProperties.AutomationId="CoolingDeviceHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="112"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding Reading}" ContentTemplate="{StaticResource FanGlyph}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Connection}"/></StackPanel>
        <ContentControl Grid.Column="2" Content="{Binding Reading}" ContentTemplate="{StaticResource RpmReadout}" Margin="0,0,18,0"/>
        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="現在値" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding CurrentDuty}" FontSize="22" FontWeight="SemiBold" AutomationProperties.AutomationId="CoolingCurrentDuty" AutomationProperties.Name="{Binding Name,StringFormat={}{0} の現在の出力}"/></StackPanel>
       </Grid>
       <Grid Margin="20,14,0,0" AutomationProperties.AutomationId="CoolingDraftControls"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" IsEnabled="{Binding CanSelectMode}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name,StringFormat={}{0} の制御方式}"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding ModeChanged,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingModePending"/></StackPanel>
        <Grid Grid.Column="1" Margin="15,0,10,0" VerticalAlignment="Center">
         <Grid Visibility="{Binding Fixed,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="設定値" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding DutyChanged,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingDutyPending"/></StackPanel>
          <Slider Grid.Column="1" Value="{Binding Duty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Name,StringFormat={}{0} の出力}" AutomationProperties.AutomationId="CoolingDraftDuty"/>
          <TextBlock Grid.Column="2" Text="{Binding Duty,StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
         </Grid>
         <StackPanel Visibility="{Binding Automatic,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProfileId}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding ProfileChanged,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingProfilePending"/></StackPanel>
         <TextBlock Text="出力率未取得" Style="{StaticResource Muted}" Visibility="{Binding UnknownManagedDuty,Converter={StaticResource BoolVisibility}}"/>
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Margin="0" Content="適用" Style="{StaticResource Primary}" Command="{Binding DataContext.Apply,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name,StringFormat={}{0} に適用}" AutomationProperties.AutomationId="CoolingApplyButton"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding HasPendingChanges,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingApplyPending"/></StackPanel>
       </Grid>
       <Button Content="変更を戻す" Command="{Binding DataContext.Revert,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" Width="96" Margin="20,6,0,0" Visibility="{Binding CanRevert,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingRevertButton"/>
       <WrapPanel Margin="20,10,0,0" HorizontalAlignment="Right" Visibility="{Binding NeedsSetup,Converter={StaticResource BoolVisibility}}">
        <Button Content="制御設定" Command="{Binding DataContext.OpenCoolingSetup,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Click="BringSetupIntoView" Margin="0,0,0,8" AutomationProperties.Name="{Binding Name,StringFormat={}{0} の端子を設定}"/>
       </WrapPanel>
       <Expander Style="{StaticResource SettingsSectionExpander}" Margin="20,14,0,0" IsExpanded="{Binding DetailsExpanded}" AutomationProperties.AutomationId="CoolingDetailsSection"><Expander.Header><WrapPanel><TextBlock Text="詳細" Margin="0,0,12,0"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></WrapPanel></Expander.Header><StackPanel>
        <WrapPanel><Button Content="{Binding ReleaseLabel}" Visibility="{Binding SupportsRelease,Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.Release,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,8"/><Button Content="再開" Command="{Binding DataContext.Resume,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,8"/></WrapPanel>
        <WrapPanel><Button Content="カーブ・温度保護" Command="{Binding DataContext.EditCoolingSettings,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,8" AutomationProperties.AutomationId="CoolingEditSettingsButton"/></WrapPanel>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0" Visibility="{Binding ShowSettingsEditor,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingSettingsEditorFrame"><local:DeviceCoolingSettingsView DataContext="{Binding SettingsEditor}"/></Border>
       </StackPanel></Expander>
       <TextBlock Text="{Binding Message}" Style="{StaticResource OptionalNote}" Margin="20,8,0,0"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Expander Header="回転数の校正" Style="{StaticResource SettingsSectionExpander}" IsExpanded="{Binding CalibrationExpanded}" Margin="0,0,0,22" Visibility="{Binding CalibrationSupported,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingCalibrationSection"><local:DeviceCoolingCalibrationView/></Expander>
     <Expander Header="グループ" Style="{StaticResource SettingsSectionExpander}" Margin="0,0,0,22" Visibility="{Binding CoolingGroupsSupported,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingGroupsSection"><local:DeviceCoolingGroupsView/></Expander>
    </StackPanel>
    <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=2}" AutomationProperties.AutomationId="LightingPage">
     <TextBlock Text="照明" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="LightingPageTitle"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="対象" Style="{StaticResource Muted}" Margin="0,0,0,10"/><WrapPanel><Button Content="全選択" Command="{Binding SelectAllLights}" Padding="8,5"/><Button Content="選択解除" Command="{Binding SelectAllLights}" CommandParameter="none" Padding="8,5"/></WrapPanel>
       <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="照明の選択一覧" AutomationProperties.AutomationId="LightingTargetsScroll">
       <ItemsControl ItemsSource="{Binding Lights}" IsEnabled="{Binding LightingIdle}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10,0,8">
        <CheckBox IsChecked="{Binding Selected}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,0"/>
        <Button Content="{Binding SetupLabel}" Command="{Binding DataContext.OpenLightingSetup,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Click="BringSetupIntoView" Visibility="{Binding NeedsSetup,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="22,5,0,0" Padding="8,5"/>
        <TextBlock Text="{Binding Result}" ToolTip="{Binding Details}" AutomationProperties.HelpText="{Binding Details}" Style="{StaticResource OptionalNote}" FontSize="10" Margin="22,2,0,0"/>
       </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
      </StackPanel>
      <StackPanel Grid.Column="2" AutomationProperties.AutomationId="LightingEverydayControls">
       <TextBlock Text="{Binding LightSelectionSummary}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
       <StackPanel VerticalAlignment="Center"><ComboBox ItemsSource="{Binding LightEffects}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding LightEffect}" IsEnabled="{Binding LightingIdle}" Margin="0,0,0,14" AutomationProperties.Name="照明効果"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding LightEffectPending,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="LightingEffectPending"/></StackPanel>
       <WrapPanel Visibility="{Binding LightAllowsPerLed,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10" VerticalAlignment="Center"><CheckBox Content="LEDごとの色" IsChecked="{Binding LightPerLed}" IsEnabled="{Binding LightingIdle}"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding LightPerLedPending,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="LightingPerLedPending"/></WrapPanel>
       <DockPanel Margin="0,0,0,12" Visibility="{Binding LightHasPalette,Converter={StaticResource BoolVisibility}}">
        <WrapPanel DockPanel.Dock="Right"><Button Content="＋" Command="{Binding AddLightColor}" AutomationProperties.Name="色を追加"/><Button Content="−" Command="{Binding RemoveLightColor}" AutomationProperties.Name="色を削除"/></WrapPanel>
        <ComboBox ItemsSource="{Binding LightPalette}" SelectedValuePath="Index" SelectedValue="{Binding SelectedLightColor}" IsEnabled="{Binding LightingIdle}" AutomationProperties.Name="編集する照明色"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="22" Height="18" Background="{Binding Brush}" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
       </DockPanel>
       <WrapPanel Margin="0,0,0,6"><TextBlock Text="色" Style="{StaticResource Muted}"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0" Visibility="{Binding LightColorPending,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="LightingColorPending"/></WrapPanel>
       <local:ColorPicker SelectedColor="{Binding LightColor}" Palette="{Binding LightSavedColors}" IsEnabled="{Binding CanPickLightColor}"/>
       <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="明るさ" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding LightBrightnessPending,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="LightingBrightnessPending"/></StackPanel><Slider Grid.Column="1" Value="{Binding LightBrightness,UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding CanEditLightBrightness}" AutomationProperties.Name="照明の明るさ"/><TextBlock Grid.Column="2" Text="{Binding LightBrightness,StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
       <Grid Margin="0,8,0,0" Visibility="{Binding LightHasSpeed,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="速さ" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding LightSpeedPending,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="LightingSpeedPending"/></StackPanel><Slider Grid.Column="1" Value="{Binding LightSpeed,UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding LightSpeedMinimum}" Maximum="{Binding LightSpeedMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding LightingIdle}" AutomationProperties.Name="照明効果の速さ"/><TextBlock Grid.Column="2" Text="{Binding LightSpeed}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
       <WrapPanel Visibility="{Binding LightHasDirection,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" VerticalAlignment="Center"><CheckBox Content="逆方向" IsChecked="{Binding LightReverse}" IsEnabled="{Binding LightingIdle}"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding LightDirectionPending,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="LightingDirectionPending"/></WrapPanel>
       <Border Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="16" Margin="0,16,0,0"><DockPanel><TextBlock Text="{Binding LightPreviewLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Border Background="{Binding LightPreviewBrush}" Height="25" Width="190" CornerRadius="12" HorizontalAlignment="Right"/></DockPanel></Border>

      </StackPanel>
     </Grid>
     <Expander Header="詳細" Style="{StaticResource SettingsSectionExpander}" Margin="0,16,0,12" AutomationProperties.AutomationId="LightingAdvancedSection"><StackPanel>
       <TextBlock Text="グループ" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding LightGroups}" SelectedItem="{Binding SelectedLightGroup}" DisplayMemberPath="Name"/><Button Content="対象を選択" Command="{Binding ChooseLightGroup}"/>
       <Expander Header="シーン・グループ" Style="{StaticResource SettingsSectionExpander}" Margin="0,12,0,12" AutomationProperties.AutomationId="LightingScenesSection"><StackPanel>
        <TextBlock Text="シーン" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="呼び出す" Command="{Binding ApplyLightScene}"/><ComboBox ItemsSource="{Binding LightScenes}" SelectedItem="{Binding SelectedLightScene}" DisplayMemberPath="Name"/></DockPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="保存" Command="{Binding SaveLightScene}"/><local:DraftTextBox Style="{StaticResource {x:Type TextBox}}" Draft="{Binding LightSceneName}" MaxLength="80" AutomationProperties.Name="新しい照明シーンの名前"/></DockPanel>
        <TextBlock Text="グループ" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="保存" Command="{Binding SaveLightGroup}"/><local:DraftTextBox Style="{StaticResource {x:Type TextBox}}" Draft="{Binding LightGroupName}" MaxLength="80" AutomationProperties.Name="新しい照明グループの名前"/></DockPanel>
       </StackPanel></Expander>
      <local:DeviceLightingLevelsView/>
     <Expander Header="照明の名前" Style="{StaticResource SettingsSectionExpander}" Margin="0,12,0,12" Visibility="{Binding LightPersonalizationSupported,Converter={StaticResource BoolVisibility}}">
      <StackPanel Margin="0,12,0,0">
       <ComboBox ItemsSource="{Binding LightAliasTargets}" SelectedItem="{Binding LightAliasTarget}" IsEnabled="{Binding LightingIdle}" DisplayMemberPath="Name" AutomationProperties.Name="名前を変更する照明"/>
       <local:DraftTextBox Style="{StaticResource {x:Type TextBox}}" Draft="{Binding LightAlias}" IsEnabled="{Binding CanEditLightAlias}" MaxLength="80" Margin="0,8,0,0" AutomationProperties.Name="照明の名前"/>
       <TextBlock Text="{Binding LightAliasStatus}" Style="{StaticResource OptionalNote}"/>
       <WrapPanel><Button Content="保存" Command="{Binding SaveLightAlias}" Visibility="{Binding HasLightAliasTarget,Converter={StaticResource BoolVisibility}}"/><Button Content="再取得" Command="{Binding ReloadLightAliasCommand}"/>
        <Button Content="3秒点灯" Command="{Binding IdentifyLight}" ToolTip="{Binding LightIdentificationProblem}" AutomationProperties.Name="照明を3秒間識別" Visibility="{Binding LightIdentificationSupported,Converter={StaticResource BoolVisibility}}"/>
        <Button Content="中止" Command="{Binding CancelLightIdentification}" Visibility="{Binding LightIdentificationRunning,Converter={StaticResource BoolVisibility}}"/>
       </WrapPanel>
       <TextBlock Text="{Binding LightIdentificationMessage}" Style="{StaticResource OptionalNote}"/>
      </StackPanel>
     </Expander>
     <local:DeviceLightingLibraryView/>
      </StackPanel></Expander>
    </StackPanel>
    <StackPanel Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=3}">
     <TextBlock Text="設定" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="SettingsPageTitle"/>
     <TextBlock Text="基本設定" Style="{StaticResource SubsectionTitle}" Margin="0,0,0,12"/>
     <local:DeviceLoginStartupView/>
     <local:DeviceNotificationsView/>
     <Expander Header="起動時の冷却" Style="{StaticResource SettingsSectionExpander}" Margin="0,0,0,22" Visibility="{Binding StartupSupported,Converter={StaticResource BoolVisibility}}"><StackPanel IsEnabled="{Binding StartupIdle}">
      <CheckBox Content="前回の制御を再開" IsChecked="{Binding StartupEnabled}" Margin="0,12" AutomationProperties.Name="起動時の冷却を再開"/>
      <ItemsControl ItemsSource="{Binding StartupRows}" IsEnabled="{Binding StartupEnabled}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Padding="6,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" AutomationProperties.Name="起動時に再開する端子"/>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,10,0" TextWrapping="Wrap"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Policy}" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <WrapPanel Margin="0,12,0,0"><Button Content="保存" Command="{Binding SaveStartup}"/><Button Content="再取得" Command="{Binding ReloadStartup}"/><TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center"/></WrapPanel>
     </StackPanel></Expander>
     <TextBlock Text="モニター" Style="{StaticResource SubsectionTitle}" Margin="0,8,0,12"/>
     <Expander Header="センサーの追加" Style="{StaticResource SettingsSectionExpander}" IsExpanded="True" Margin="0,0,0,22" Visibility="{Binding HasMonitoringCandidates,Converter={StaticResource BoolVisibility}}"><StackPanel>
      <WrapPanel Visibility="{Binding HasMonitoringPages,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"><Button Content="前へ" Command="{Binding PreviousMonitoringPage}" AutomationProperties.Name="監視候補の前ページ"/><TextBlock Text="{Binding MonitoringPageLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/><Button Content="次へ" Command="{Binding NextMonitoringPage}" AutomationProperties.Name="監視候補の次ページ"/></WrapPanel>
      <ItemsControl ItemsSource="{Binding MonitoringCandidates}" IsEnabled="{Binding MonitoringIdle}"><ItemsControl.ItemTemplate><DataTemplate>
