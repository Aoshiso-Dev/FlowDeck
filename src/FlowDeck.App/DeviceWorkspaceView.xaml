        <DockPanel Margin="0,0,0,10"><TextBlock Text="異常時出力" Width="90" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="%（1〜100）" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/><local:DraftTextBox Style="{StaticResource {x:Type TextBox}}" Draft="{Binding FallbackText}" MaxLength="3" AutomationProperties.Name="異常時出力"/></DockPanel>
        <DockPanel Margin="0,0,0,10"><TextBlock Text="終了時" Width="90" Style="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding CoolingExits}" SelectedValue="{Binding CoolingExit}" SelectedValuePath="Value" DisplayMemberPath="Name"/></DockPanel>
