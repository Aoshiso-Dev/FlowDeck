  <StatusBar x:Name="WorkspaceStatusBar" Grid.Row="1" Grid.ColumnSpan="2" Height="38" Padding="12,4" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
   AutomationProperties.AutomationId="WorkspaceStatusBar" AutomationProperties.Name="ステータスバー">
   <StatusBar.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></StatusBar.ItemsPanel>
   <StatusBarItem HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="WorkspaceStatusMessage" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Height="20" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,12,0"
      AutomationProperties.AutomationId="WorkspaceStatusMessage" AutomationProperties.Name="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
     <ToggleButton x:Name="StatusDetailsButton" Grid.Column="1" Content="詳細" IsEnabled="{Binding HasStatusDetails}" Click="ToggleStatusDetails" Height="28" MinWidth="56" Padding="10,3"
      AutomationProperties.AutomationId="StatusDetailsButton" AutomationProperties.Name="ステータスメッセージの詳細">
      <ToggleButton.Style><Style TargetType="ToggleButton">
       <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InsetBrush}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
       </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style></ToggleButton.Style>
     </ToggleButton>
    </Grid>
   </StatusBarItem>
  </StatusBar>
  <Popup x:Name="StatusDetailsPopup" PlacementTarget="{Binding ElementName=WorkspaceStatusBar}" Placement="Top" HorizontalOffset="8" VerticalOffset="-6" AllowsTransparency="True" StaysOpen="True" Opened="StatusDetailsOpened" Closed="StatusDetailsClosed">
   <Border x:Name="StatusDetailsPanel" Width="{Binding ActualWidth,ElementName=WorkspaceStatusBar}" MaxWidth="760" MaxHeight="280" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="StatusDetailsKeyDown"
    AutomationProperties.AutomationId="StatusDetailsPopup" AutomationProperties.Name="直近のメッセージ">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><Button x:Name="StatusDetailsCloseButton" DockPanel.Dock="Right" Content="閉じる" Click="CloseStatusDetails" MinHeight="28" Padding="10,3" Margin="12,0,0,0" TabIndex="1" AutomationProperties.AutomationId="StatusDetailsCloseButton" AutomationProperties.Name="メッセージの詳細を閉じる"/><TextBlock Text="メッセージ" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/></DockPanel>
     <TextBox x:Name="StatusDetailsText" Grid.Row="1" Text="{Binding StatusDetails,Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="208" Padding="8" Background="{DynamicResource InsetBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" TabIndex="0"
      AutomationProperties.AutomationId="StatusDetailsText" AutomationProperties.Name="直近のメッセージの全文"/>
    </Grid>
   </Border>
  </Popup>
 </Grid>
</UserControl>
