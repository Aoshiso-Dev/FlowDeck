      <StackPanel IsEnabled="{Binding SetupIdle}" Margin="0,12,0,0">
       <ComboBox ItemsSource="{Binding CacheHistoryChoices}" SelectedItem="{Binding SelectedCacheHistory}" DisplayMemberPath="Label" AutomationProperties.Name="整理する検出履歴" Margin="0,0,0,12"/>
