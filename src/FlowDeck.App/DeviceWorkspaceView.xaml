       </StackPanel>
       <StackPanel Visibility="{Binding Lighting,Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Accessory}" Style="{StaticResource OptionalNote}"/>
        <TextBlock Text="{Binding LedCountNotice}" Style="{StaticResource OptionalNote}" TextWrapping="Wrap"/>
