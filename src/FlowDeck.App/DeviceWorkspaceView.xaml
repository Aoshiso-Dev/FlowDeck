   <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10,12,4" Margin="0,12,0,0" Visibility="{Binding SelectedPage,Converter={StaticResource PageVisibility},ConverterParameter=2}" AutomationProperties.AutomationId="LightingApplyFooter">
