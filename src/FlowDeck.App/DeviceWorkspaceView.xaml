        <StackPanel Visibility="{Binding RegistrationRemovalSupported,Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
         <Button Content="登録解除…" Command="{Binding PreviewRegistrationRemoval}" HorizontalAlignment="Left" AutomationProperties.Name="機器の登録解除を確認"/>
         <TextBlock Text="{Binding RegistrationRemovalStatus}" Style="{StaticResource OptionalNote}" Margin="0,8,0,0"/>
