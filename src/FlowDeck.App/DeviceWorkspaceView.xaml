        <DockPanel Margin="0,0,0,10"><TextBlock Text="終了時" Width="90" Style="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding LightingExits}" SelectedValue="{Binding LightingExit}" SelectedValuePath="Value" DisplayMemberPath="Name"/></DockPanel>
