<UserControl x:Class="FlowDeck.App.DeviceM5SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App">
 <Expander Header="M5GO" IsExpanded="{Binding M5Expanded}" Margin="0,0,0,22">
  <StackPanel Margin="0,12,0,0">
   <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding M5ConnectionSupported,Converter={StaticResource BoolVisibility}}"><StackPanel>
    <TextBlock Text="{Binding M5LinkStatus}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding M5LinkDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <WrapPanel><Button Content="接続" Command="{Binding ConnectM5}"/><Button Content="切断" Command="{Binding DisconnectM5}"/><Button Content="このM5GOを登録" Command="{Binding RegisterM5}"/></WrapPanel>
    <Expander Header="Wi-Fi登録" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0">
     <Grid IsEnabled="{Binding M5ConnectionIdle}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="SSID（2.4GHz）" Style="{StaticResource Label}"/><local:DraftTextBox Draft="{Binding M5Ssid}" Style="{StaticResource {x:Type TextBox}}" MaxLength="32" AutomationProperties.Name="M5GOのSSID"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="パスワード" Style="{StaticResource Label}"/><PasswordBox x:Name="WifiPassword" MaxLength="63" AutomationProperties.Name="M5GOのWi-Fiパスワード"/></StackPanel>
     </Grid><Button Content="USBでWi-Fiを登録" IsEnabled="{Binding CanPairM5}" Click="PairWifi" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </StackPanel></Expander>
   </StackPanel></Border>
   <StackPanel IsEnabled="{Binding SetupIdle}"><StackPanel DataContext="{Binding M5Editor}">
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="ホーム" Style="{StaticResource SectionTitle}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="CPU温度" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Cpus}" SelectedItem="{Binding Cpu}" DisplayMemberPath="Name" AutomationProperties.Name="M5GOのCPU温度"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="GPU温度" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding Gpu}" DisplayMemberPath="Name" AutomationProperties.Name="M5GOのGPU温度"/></StackPanel>
     </Grid>
     <TextBlock Text="表示するHub" Style="{StaticResource Label}" Margin="0,16,0,6"/>
     <ComboBox ItemsSource="{Binding Hubs}" SelectedItem="{Binding Hub}" DisplayMemberPath="Name" AutomationProperties.Name="M5GOのHub"/>
     <StackPanel Visibility="{Binding HasHub,Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0">
      <TextBlock Text="回転数は選択したHubから表示します。ボタンで操作する端子だけ選んでください。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="操作するファン" Style="{StaticResource Label}"/><ItemsControl ItemsSource="{Binding Fans}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding Available}" Margin="0,0,20,8" AutomationProperties.Name="M5GOのファン端子"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="操作する照明" Style="{StaticResource Label}"/><ItemsControl ItemsSource="{Binding Leds}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding Available}" Margin="0,0,20,8" AutomationProperties.Name="M5GOの照明端子"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex}" DisplayMemberPath="Name" AutomationProperties.Name="M5GOのプリセット"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasBoard,Converter={StaticResource BoolVisibility}}"><StackPanel>
     <DockPanel><TextBlock Text="マザーボード" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding BoardCount}" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></DockPanel>
     <ItemsControl ItemsSource="{Binding Board}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition Width="98"/></Grid.ColumnDefinitions>
      <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" AutomationProperties.Name="M5GOのマザー表示"/>
      <local:DraftTextBox Grid.Column="1" Draft="{Binding Name}" IsEnabled="{Binding Selected}" Style="{StaticResource {x:Type TextBox}}" MaxLength="160" AutomationProperties.Name="M5GOの表示名"/>
      <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Muted}"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="↑" Command="{Binding Up}" AutomationProperties.Name="M5GOの表示を上へ"/><Button Content="↓" Command="{Binding Down}" AutomationProperties.Name="M5GOの表示を下へ"/></StackPanel>
     </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <Expander Header="接続・レイアウト" Margin="0,0,0,12"><StackPanel Margin="0,12,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="接続方式" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Transports}" SelectedValue="{Binding Transport}" SelectedValuePath="Value" DisplayMemberPath="Name" AutomationProperties.Name="M5GOの接続方式"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="USBポート" Style="{StaticResource Label}"/><local:DraftTextBox Draft="{Binding Port}" Style="{StaticResource {x:Type TextBox}}" MaxLength="8" AutomationProperties.Name="M5GOのUSBポート"/></StackPanel>
     </Grid>
     <Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="PCのLANアドレス" Style="{StaticResource Label}"/><local:DraftTextBox Draft="{Binding Address}" Style="{StaticResource {x:Type TextBox}}" MaxLength="15" AutomationProperties.Name="M5GOのLANアドレス"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="レイアウト" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" AutomationProperties.Name="M5GOのレイアウト"/></StackPanel>
     </Grid><CheckBox Content="起動時に接続" IsChecked="{Binding ConnectOnStart}" IsEnabled="{Binding CanAutoConnect}"/>
    </StackPanel></Expander>
   </StackPanel></StackPanel>
   <WrapPanel><Button Content="設定を保存" Style="{StaticResource Primary}" Command="{Binding SaveM5}"/><Button Content="再取得" Command="{Binding ReloadM5}"/><TextBlock Text="{Binding M5EditStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap"/></WrapPanel>
   <TextBlock Text="{Binding M5Message}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
 </Expander>
</UserControl>
