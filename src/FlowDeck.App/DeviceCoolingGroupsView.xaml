<UserControl x:Class="FlowDeck.App.DeviceCoolingGroupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App">
 <StackPanel>
  <DockPanel Margin="0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="新規" Command="{Binding NewCoolingGroup}"/><Button Content="編集" Command="{Binding EditCoolingGroup}"/><Button Content="再取得" Command="{Binding ReloadCoolingGroups}"/></StackPanel><ComboBox ItemsSource="{Binding CoolingGroups}" SelectedItem="{Binding SelectedCoolingGroup}" DisplayMemberPath="Name" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="冷却グループ"/></DockPanel>
  <StackPanel Visibility="{Binding HasCoolingGroup,Converter={StaticResource BoolVisibility}}">
   <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <ComboBox ItemsSource="{Binding CoolingGroupModes}" SelectedItem="{Binding CoolingGroupMode}" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="グループの制御方式"/>
    <Grid Grid.Column="1" Margin="16,0" Visibility="{Binding CoolingGroupFixed,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="要求" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CoolingGroupDuty,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="グループの要求出力"/><TextBlock Grid.Column="2" Text="{Binding CoolingGroupDuty,StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <ComboBox Grid.Column="1" Margin="16,0" ItemsSource="{Binding CoolingGroupProfiles}" SelectedItem="{Binding CoolingGroupProfile}" DisplayMemberPath="Name" Visibility="{Binding CoolingGroupAutomatic,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="グループの温度カーブ"/>
    <Button Grid.Column="2" Content="適用" Style="{StaticResource Primary}" Command="{Binding ApplyCoolingGroup}"/>
   </Grid>
   <TextBlock Text="{Binding CoolingGroupStatus}" Style="{StaticResource OptionalNote}"/>
   <ItemsControl ItemsSource="{Binding CoolingGroupReadings}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="88"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Rpm}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Duty,StringFormat=現在 {0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Minimum}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding Result}" Style="{StaticResource OptionalNote}" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="各端子の設定で制御を終了" Command="{Binding ReleaseCoolingGroup}" Visibility="{Binding ShowReleaseCoolingGroup,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,12,0,4"/>
  </StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,14,0,4" Visibility="{Binding HasCoolingGroupEditor,Converter={StaticResource BoolVisibility}}"><StackPanel IsEnabled="{Binding CoolingGroupsIdle}">
   <local:DraftTextBox Style="{StaticResource {x:Type TextBox}}" Draft="{Binding GroupEditor.Name}" MaxLength="80" AutomationProperties.Name="冷却グループ名"/>
   <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8"><ItemsControl ItemsSource="{Binding GroupEditor.Members}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" Margin="0,6" AutomationProperties.Name="冷却グループの端子"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock Text="{Binding GroupEditor.Status}" Style="{StaticResource Muted}"/>
   <WrapPanel Margin="0,10,0,0"><Button Content="グループを保存" Command="{Binding SaveCoolingGroup}"/><Button Content="グループを削除" Command="{Binding DeleteCoolingGroup}"/><Button Content="閉じる" Command="{Binding CloseCoolingGroupEditor}"/></WrapPanel>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
