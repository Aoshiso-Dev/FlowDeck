<UserControl x:Class="FlowDeck.App.DeviceCoolingGroupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App">
 <StackPanel>
  <Grid Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding CoolingGroups}" SelectedItem="{Binding SelectedCoolingGroup}" DisplayMemberPath="Name" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="冷却グループ"/><WrapPanel Grid.Row="1" Margin="0,8,0,0"><Button Content="新規" Command="{Binding NewCoolingGroup}" Margin="0,0,8,8"/><Button Content="編集" Command="{Binding EditCoolingGroup}" Margin="0,0,8,8"/><Button Content="再取得" Command="{Binding ReloadCoolingGroups}" Margin="0,0,8,8"/></WrapPanel></Grid>
  <StackPanel Visibility="{Binding HasCoolingGroup,Converter={StaticResource BoolVisibility}}">
   <Grid Margin="0,0,0,12" AutomationProperties.AutomationId="CoolingGroupControls"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><ComboBox ItemsSource="{Binding CoolingGroupModes}" SelectedItem="{Binding CoolingGroupMode}" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="グループの制御方式"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding CoolingGroupModeChanged,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingGroupModePending"/></StackPanel>
    <Grid Grid.Column="1" Margin="16,0" Visibility="{Binding CoolingGroupFixed,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="設定値" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding CoolingGroupDutyChanged,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingGroupDutyPending"/></StackPanel><Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CoolingGroupDuty,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="グループの要求出力"/><TextBlock Grid.Column="2" Text="{Binding CoolingGroupDuty,StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Column="1" Margin="16,0" Visibility="{Binding CoolingGroupAutomatic,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding CoolingGroupProfiles}" SelectedItem="{Binding CoolingGroupProfile}" DisplayMemberPath="Name" IsEnabled="{Binding CoolingGroupsIdle}" AutomationProperties.Name="グループの温度カーブ"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding CoolingGroupProfileChanged,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingGroupProfilePending"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="適用" Style="{StaticResource Primary}" Command="{Binding ApplyCoolingGroup}" AutomationProperties.AutomationId="CoolingGroupApplyButton"/><TextBlock Text="未適用" Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0" Visibility="{Binding CoolingGroupHasPendingChanges,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingGroupApplyPending"/></StackPanel>
   </Grid>
   <TextBlock Text="{Binding CoolingGroupStatus}" Style="{StaticResource OptionalNote}"/>
   <ItemsControl ItemsSource="{Binding CoolingGroupReadings}" AutomationProperties.AutomationId="CoolingGroupReadings"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,8,0,0" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="88"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Rpm}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Duty,StringFormat=現在 {0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Minimum}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding Result}" Style="{StaticResource OptionalNote}" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="制御終了（各端子の設定）" Command="{Binding ReleaseCoolingGroup}" Visibility="{Binding ShowReleaseCoolingGroup,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,12,0,4"/>
  </StackPanel>
  <Border Style="{StaticResource Card}" Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="14" Margin="0,14,0,0" Visibility="{Binding HasCoolingGroupEditor,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingGroupEditorFrame"><StackPanel IsEnabled="{Binding CoolingGroupsIdle}">
   <local:DraftTextBox Style="{StaticResource {x:Type TextBox}}" Draft="{Binding GroupEditor.Name}" MaxLength="80" AutomationProperties.Name="冷却グループ名"/>
   <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8"><ItemsControl ItemsSource="{Binding GroupEditor.Members}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" Margin="0,6" AutomationProperties.Name="冷却グループの端子"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock Text="{Binding GroupEditor.Status}" Style="{StaticResource OptionalNote}"/>
   <WrapPanel Margin="0,10,0,0"><Button Content="保存" Command="{Binding SaveCoolingGroup}" Margin="0,0,8,8"/><Button Content="削除" Command="{Binding DeleteCoolingGroup}" Margin="0,0,8,8"/><Button Content="閉じる" Command="{Binding CloseCoolingGroupEditor}" Margin="0,0,8,8"/></WrapPanel>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
