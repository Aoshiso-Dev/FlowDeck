<UserControl x:Class="FlowDeck.App.DeviceCoolingCalibrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="再取得" Command="{Binding ReloadCalibration}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="中止・復元" Command="{Binding CancelCalibration}" Visibility="{Binding CanCancelCalibration,Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding CalibrationChoices}" SelectedItem="{Binding SelectedCalibration}" DisplayMemberPath="Name" IsEnabled="{Binding CalibrationIdle}" AutomationProperties.Name="試験する端子"/></DockPanel>
  <Border Style="{StaticResource Card}" Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="14" Margin="0,0,0,12" Visibility="{Binding HasCalibrationEditor,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingCalibrationEditorFrame"><StackPanel>
   <StackPanel DataContext="{Binding CalibrationEditor}">
    <DockPanel Margin="0,0,0,14"><TextBlock Text="{Binding CurrentRpm}" FontSize="26" FontWeight="Light"/><TextBlock Text="{Binding CurrentDuty}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/></DockPanel>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="試験出力" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Duty,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReduce}" AutomationProperties.Name="校正の試験出力"/><TextBlock Grid.Column="2" Text="{Binding Duty,StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="試験時間" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="5秒"/><TextBlock Grid.Row="1" Text="試験後" Style="{StaticResource Muted}" Margin="0,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Restoration}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Grid.Row="2" Text="起動時再開" Style="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="保留"/></Grid>
    <TextBlock Text="{Binding Status}" Style="{StaticResource OptionalNote}" TextWrapping="Wrap"/>
   </StackPanel>
   <WrapPanel Margin="0,12,0,0"><Button Content="試験開始" Style="{StaticResource Primary}" Command="{Binding StartCalibration}" Margin="0,0,8,8"/></WrapPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="14" Margin="0" Visibility="{Binding HasCalibrationResult,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingCalibrationResultFrame"><StackPanel>
   <StackPanel DataContext="{Binding CalibrationEditor}"><TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Before}" Style="{StaticResource OptionalNote}" Margin="0,8,0,0"/><TextBlock Text="{Binding ResultRpm}" FontSize="18" Margin="0,8"/><TextBlock Text="{Binding ResultMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
   </StackPanel>
   <Button Content="最低出力欄に反映" Command="{Binding AdoptCalibration}" HorizontalAlignment="Left" Visibility="{Binding CalibrationEditor.Successful,Converter={StaticResource BoolVisibility}}"/>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
