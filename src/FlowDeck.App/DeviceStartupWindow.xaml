<Window x:Class="FlowDeck.App.DeviceStartupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FlowDeck" Width="600" Height="390" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterScreen"
 Icon="Assets/FlowDeck.ico" Style="{StaticResource {x:Type Window}}">
 <Border Background="{DynamicResource BackgroundBrush}" Padding="32"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><TextBlock Text="FlowDeck" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <ComboBox x:Name="ThemeChoice" Width="124" HorizontalAlignment="Right" SelectedValuePath="Tag" AutomationProperties.Name="配色">
    <ComboBoxItem Content="システム" Tag="system"/><ComboBoxItem Content="ライト" Tag="light"/><ComboBoxItem Content="ダーク" Tag="dark"/>
   </ComboBox>
  </Grid>
  <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24">
   <TextBlock Text="サービス接続" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
   <TextBlock x:Name="StatusText" Text="接続しています…" FontSize="21" FontWeight="SemiBold"/>
   <TextBlock x:Name="NextActionText" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
   <TextBlock x:Name="PreferenceError" Style="{StaticResource OptionalNote}" Margin="0,8,0,0"/>
  </StackPanel>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
   <Button x:Name="SetupButton" Content="導入・更新" MinWidth="108" Click="OpenSetup"/>
   <Button x:Name="MonitorButton" Content="監視を開く" MinWidth="108" Click="OpenMonitoring"/>
   <Button x:Name="RetryButton" Content="再接続" Style="{StaticResource Primary}" MinWidth="108" Click="Retry" IsDefault="True"/>
   <Button x:Name="CloseButton" Content="閉じる" Click="Exit" Margin="0" MinWidth="80"/>
  </WrapPanel>
 </Grid></Border>
</Window>
