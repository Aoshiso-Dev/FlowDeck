<UserControl x:Class="FlowDeck.App.DeviceCoolingSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App">
 <UserControl.Resources>
  <DataTemplate x:Key="TemperatureThresholds"><StackPanel>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <TextBlock Text="過熱" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="1" Maximum="149" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Overheat,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="過熱温度"/><TextBlock Grid.Column="2" Text="{Binding Overheat,StringFormat={}{0:0.#}°C}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <TextBlock Text="復帰温度未満" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="1" Maximum="149" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ResumeBelow,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="復帰温度"/><TextBlock Grid.Column="2" Text="{Binding ResumeBelow,StringFormat={}{0:0.#}°C}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </StackPanel></DataTemplate>
 </UserControl.Resources>
 <StackPanel IsEnabled="{Binding Editable}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="編集する温度カーブ"/>
   <local:DraftTextBox Grid.Column="1" Style="{StaticResource {x:Type TextBox}}" Draft="{Binding SelectedProfile.Name}" MaxLength="80" IsEnabled="{Binding HasProfile}" AutomationProperties.Name="温度カーブの名前"/>
   <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"><Button Content="新規" Command="{Binding AddProfile}" VerticalAlignment="Center" Margin="0,0,8,8"/><Button Content="削除" Command="{Binding DeleteProfile}" VerticalAlignment="Center" Margin="0,0,8,8"/></WrapPanel>
  </Grid>
  <StackPanel Visibility="{Binding HasProfile,Converter={StaticResource BoolVisibility}}">
   <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor}" DisplayMemberPath="Name" AutomationProperties.Name="カーブに追加する温度源"/>
    <Button Grid.Column="1" Content="追加" Command="{Binding AddCurve}"/>
   </Grid>
   <ItemsControl ItemsSource="{Binding SelectedProfile.Curves}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Card}" Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="14" Margin="0,0,0,12"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="外す" Command="{Binding DataContext.RemoveCurve,RelativeSource={RelativeSource AncestorType=local:DeviceCoolingSettingsView}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Sensor.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sensor.Name}"/></DockPanel>
     <local:CurveChart x:Name="Graph" Points="{Binding Points}" MinimumDuty="{Binding DataContext.Draft.Safety.Minimum,RelativeSource={RelativeSource AncestorType=local:DeviceCoolingSettingsView}}" RequestedOutput="True" CurrentTemperature="{Binding Temperature}" CurrentDuty="{Binding CurrentDuty}" Height="230" Margin="0,8"/>
     <WrapPanel><Button Content="点追加" Command="{Binding AddPointCommand,ElementName=Graph}" Margin="0,0,8,8"/><Button Content="点削除" Command="{Binding DeletePointCommand,ElementName=Graph}" Margin="0,0,8,8"/></WrapPanel>
     <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemperatureThresholds}"/>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <TextBlock Text="下降待ち" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.DescentDelay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="出力の下降待ち"/><TextBlock Grid.Column="2" Text="{Binding SelectedProfile.DescentDelay,StringFormat={}{0:0.#}秒}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <TextBlock Text="下降速度" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0.1" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.DescentRate,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="出力の下降速度"/><TextBlock Grid.Column="2" Text="{Binding SelectedProfile.DescentRate,StringFormat={}{0:0.#}%/秒}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </StackPanel>
  <Expander Header="固定出力の温度保護" Style="{StaticResource SettingsSectionExpander}" Margin="0,16,0,14" AutomationProperties.AutomationId="CoolingProtectionSection"><StackPanel>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding ProtectionSensor}" DisplayMemberPath="Name" AutomationProperties.Name="固定出力を保護する温度源"/><Button Grid.Column="1" Content="追加" Command="{Binding AddProtection}"/>
   </Grid>
   <ItemsControl ItemsSource="{Binding Protection}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Card}" Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="14" Margin="0,0,0,10"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="外す" Command="{Binding DataContext.RemoveProtection,RelativeSource={RelativeSource AncestorType=local:DeviceCoolingSettingsView}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Sensor.Name}" VerticalAlignment="Center"/></DockPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemperatureThresholds}"/></StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Expander>
  <Expander Header="停止・再始動" Style="{StaticResource SettingsSectionExpander}" Margin="0,0,0,14" Visibility="{Binding StopSectionVisible,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CoolingStopSection"><StackPanel>
   <CheckBox Content="{Binding StopLabel}" IsChecked="{Binding StopEnabled}" Margin="0,0,0,8" AutomationProperties.Name="停止を許可"/>
   <StackPanel Visibility="{Binding StopEnabled,Converter={StaticResource BoolVisibility}}">
    <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding StopSensor}" DisplayMemberPath="Name" AutomationProperties.Name="停止条件の温度源"/><Button Grid.Column="1" Content="追加" Command="{Binding AddStopCondition}"/></Grid>
    <TextBlock Text="停止条件（すべて一致）" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
    <ItemsControl ItemsSource="{Binding StopConditions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="14" Margin="0,0,0,8"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="外す" Command="{Binding DataContext.RemoveStopCondition,RelativeSource={RelativeSource AncestorType=local:DeviceCoolingSettingsView}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Sensor.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="{Binding Temperature,StringFormat={}{0:0.#}°C,TargetNullValue=—}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/></DockPanel>
     <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="停止温度未満" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="1" Maximum="149" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Below,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="停止温度"/><TextBlock Grid.Column="2" Text="{Binding Below,StringFormat={}{0:0.#}°C}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="再始動出力" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="{Binding RestartDutyMinimum}" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RestartDuty,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="再始動出力"/><TextBlock Grid.Column="2" Text="{Binding RestartDuty,StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="再始動時間" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="{Binding RestartSecondsMinimum}" Maximum="{Binding RestartSecondsMaximum}" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding RestartSeconds,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="再始動時間"/><TextBlock Grid.Column="2" Text="{Binding RestartSeconds,StringFormat={}{0:0.###}秒}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   </StackPanel>
  </StackPanel></Expander>
  <TextBlock Text="{Binding Status}" Style="{StaticResource OptionalNote}" Margin="0,4,0,8"/>
  <WrapPanel><Button Content="制御終了・保存" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveCoolingSettings,RelativeSource={RelativeSource AncestorType=local:DeviceWorkspaceView}}" CommandParameter="{Binding}" Margin="0,0,8,8" AutomationProperties.AutomationId="CoolingSaveSettingsButton"/><Button Content="再取得" Command="{Binding DataContext.ReloadCoolingSettings,RelativeSource={RelativeSource AncestorType=local:DeviceWorkspaceView}}" CommandParameter="{Binding}" Margin="0,0,8,8"/></WrapPanel>
 </StackPanel>
</UserControl>
