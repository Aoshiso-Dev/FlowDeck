<UserControl x:Class="FlowDeck.App.DeviceLoginStartupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Expander Header="起動" Style="{StaticResource SettingsSectionExpander}" IsExpanded="{Binding LoginExpanded}" Margin="0,0,0,22">
  <StackPanel>
   <CheckBox Content="ログイン時にトレイ起動" IsChecked="{Binding LoginEnabled}" IsEnabled="{Binding LoginEditable}"/>
   <CheckBox Content="このFlowDeckに置換" IsChecked="{Binding LoginReplace}" IsEnabled="{Binding LoginEditable}" Margin="0,12,0,0" Visibility="{Binding LoginConflict,Converter={StaticResource BoolVisibility}}"/>
   <WrapPanel Margin="0,16,0,0"><Button Content="保存" Command="{Binding SaveLogin}"/><Button Content="再取得" Command="{Binding ReloadLogin}"/><Button Content="スタートアップ設定" Command="{Binding OpenLoginSettings}"/></WrapPanel>
   <TextBlock Text="{Binding LoginStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Expander>
</UserControl>
