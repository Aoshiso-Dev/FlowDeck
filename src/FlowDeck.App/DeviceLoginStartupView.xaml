<UserControl x:Class="FlowDeck.App.DeviceLoginStartupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Expander Header="アプリの起動" IsExpanded="{Binding LoginExpanded}" Margin="0,0,0,22">
  <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
   <CheckBox Content="ログイン時にトレイへ起動" IsChecked="{Binding LoginEnabled}" IsEnabled="{Binding LoginEditable}"/>
   <CheckBox Content="このアプリの登録に変更する" IsChecked="{Binding LoginReplace}" IsEnabled="{Binding LoginEditable}" Margin="0,12,0,0" Visibility="{Binding LoginConflict,Converter={StaticResource BoolVisibility}}"/>
   <WrapPanel Margin="0,16,0,0"><Button Content="保存" Command="{Binding SaveLogin}"/><Button Content="再取得" Command="{Binding ReloadLogin}"/><Button Content="Windowsの許可設定" Command="{Binding OpenLoginSettings}"/></WrapPanel>
   <TextBlock Text="{Binding LoginStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
 </Expander>
</UserControl>
