<UserControl x:Class="FlowDeck.App.NotificationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowDeck.App">
 <StackPanel>
  <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding NotificationIdle}">
   <DockPanel><TextBlock Text="通知" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding NotificationSummary}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <WrapPanel><CheckBox Content="有効" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,20,8"/><CheckBox Content="Windows通知" IsChecked="{Binding NotificationsDesktop}" Margin="0,0,20,8"/><CheckBox Content="復帰" IsChecked="{Binding NotificationsRecovery}" Margin="0,0,20,8"/></WrapPanel>
   <WrapPanel Margin="0,4,0,8"><CheckBox Content="制御異常（即時）" IsChecked="{Binding NotificationsFaults}" Margin="0,0,20,0"/><CheckBox Content="接続・更新停止" IsChecked="{Binding NotificationsDisconnects}" Margin="0,0,20,0"/><CheckBox Content="操作失敗" IsChecked="{Binding NotificationsOperations}"/></WrapPanel>
   <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="異常継続" Style="{StaticResource Label}"/><TextBlock HorizontalAlignment="Right" Text="{Binding ElementName=NotificationDelaySlider,Path=Value,StringFormat={}{0:0} 秒}"/></DockPanel><Slider x:Name="NotificationDelaySlider" Minimum="0" Maximum="300" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NotificationDelay}" AutomationProperties.Name="異常の継続時間"/></StackPanel>
    <StackPanel Grid.Column="2"><DockPanel Margin="0,0,0,8"><TextBlock Text="復帰継続" Style="{StaticResource Label}"/><TextBlock HorizontalAlignment="Right" Text="{Binding ElementName=NotificationRecoverySlider,Path=Value,StringFormat={}{0:0} 秒}"/></DockPanel><Slider x:Name="NotificationRecoverySlider" Minimum="0" Maximum="300" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NotificationRecoveryDelay}" AutomationProperties.Name="復帰の継続時間"/></StackPanel>
   </Grid>
   <DockPanel Margin="0,14,0,10"><TextBlock Text="再通知" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox x:Name="NotificationRepeatPicker" ItemsSource="{Binding NotificationRepeatChoices}" SelectedItem="{Binding SelectedNotificationRepeat}" DisplayMemberPath="Name" MaxWidth="230" HorizontalAlignment="Left"/></DockPanel>
   <WrapPanel><Button Content="保存" Command="{Binding SaveNotificationSettings}" Style="{StaticResource Primary}"/><Button Content="再読込" Command="{Binding ReloadNotifications}"/><Button x:Name="NotificationTestButton" Content="通知テスト" Command="{Binding TestNotification}"/></WrapPanel>
  </StackPanel></Border>
  <Border x:Name="NotificationRulesCard" Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding NotificationIdle}">
   <DockPanel><Button Content="追加" Command="{Binding NewNotificationRule}" DockPanel.Dock="Right"/><TextBlock Text="通知条件" Style="{StaticResource SectionTitle}"/></DockPanel>
   <ComboBox x:Name="NotificationRulePicker" ItemsSource="{Binding NotificationRules}" SelectedItem="{Binding NotificationRule}" DisplayMemberPath="Label" AutomationProperties.Name="保存済みの通知条件" Margin="0,0,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="対象" Style="{StaticResource Label}"/><ComboBox x:Name="NotificationTargetPicker" ItemsSource="{Binding NotificationTargets}" SelectedItem="{Binding NotificationTarget}" DisplayMemberPath="Label" AutomationProperties.Name="通知するセンサー"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="名前" Style="{StaticResource Label}"/><local:DraftTextBox x:Name="NotificationNameBox" Style="{StaticResource {x:Type TextBox}}" Draft="{Binding NotificationName}" MaxLength="64"/></StackPanel>
   </Grid>
   <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><DockPanel Margin="0,0,0,10"><TextBlock Text="しきい値" Style="{StaticResource Label}"/><TextBlock Text="{Binding NotificationThresholdLabel}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="NotificationThresholdSlider" Minimum="{Binding NotificationThresholdMinimum}" Maximum="{Binding NotificationThresholdMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NotificationThreshold}" AutomationProperties.Name="通知のしきい値"/></StackPanel>
    <StackPanel Grid.Column="2"><DockPanel Margin="0,0,0,10"><TextBlock Text="復帰幅" Style="{StaticResource Label}"/><TextBlock Text="{Binding NotificationHysteresisLabel}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="NotificationHysteresisSlider" Minimum="0" Maximum="{Binding NotificationHysteresisMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NotificationHysteresis}" AutomationProperties.Name="通知の復帰幅"/></StackPanel>
   </Grid>
   <WrapPanel Margin="0,18,0,12"><CheckBox Content="有効" IsChecked="{Binding NotificationRuleEnabled}" Margin="0,0,18,0"/><CheckBox Content="未取得も通知" IsChecked="{Binding NotificationMissing}" Margin="0,0,18,0"/><CheckBox Content="意図した停止は除外" IsChecked="{Binding NotificationIgnoreStop}" Visibility="{Binding NotificationIsFan,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
   <WrapPanel><Button x:Name="NotificationRuleSaveButton" Content="保存" Command="{Binding SaveNotificationRule}" Style="{StaticResource Primary}"/><Button Content="削除" Command="{Binding DeleteNotificationRule}"/></WrapPanel>
  </StackPanel></Border>
  <TextBlock Text="{Binding NotificationResult}" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="通知履歴" Style="{StaticResource SectionTitle}"/>
   <ItemsControl ItemsSource="{Binding ActiveNotifications}" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <DataGrid x:Name="NotificationHistoryGrid" ItemsSource="{Binding NotificationHistory}" IsReadOnly="True" Height="200"><DataGrid.Columns><DataGridTextColumn Header="時刻" Binding="{Binding Time,StringFormat=HH:mm:ss}" Width="80"/><DataGridTextColumn Header="状態" Binding="{Binding Kind}" Width="75"/><DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
